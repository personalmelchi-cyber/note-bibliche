{
  "appId": "app.scribae",
  "appName": "Scribae",
  "webDir": "dist",
  "backgroundColor": "#ffffff",
  "ios": {
    "contentInset": "never",
    "scheme": "Scribae"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#1a1a1a",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true
    }
  }
}
